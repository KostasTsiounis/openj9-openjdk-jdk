    {CertificateFactory, X.509, *, "TestConstraints.main"}, \
    {CertStore, Collection, *, "TestConstraints.main"}, \
    {Configuration, JavaLoginConfig, *, "TestConstraints.main"}, \
    {CertPathBuilder, PKIX, *, "TestConstraints.main"}, \
    {CertPathValidator, PKIX, *, "TestConstraints.main"}, \
    {SecureRandom, SHA1PRNG, *, "TestConstraints.main"}, \
    {MessageDigest, SHA-256, *, "TestConstraints.main"}, \
    {KeyStore, PKCS12, *, "TestConstraints.main"}]
