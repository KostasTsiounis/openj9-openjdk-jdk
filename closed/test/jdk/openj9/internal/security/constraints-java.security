    {Signature, SHA256withECDSA, *, "TestConstraints.main"}, \
    {KeyPairGenerator, EC, *, "TestConstraints.main"}, \
    {KeyAgreement, ECDH, *, "TestConstraints.main"}, \
    {KeyFactory, EC, *, "TestConstraints.main"}]
RestrictedSecurity.TestConstraints.Version.jce.provider.3 = com.sun.crypto.provider.SunJCE [ \
    {Cipher, RSA, *, "TestConstraints.main"}, \
    {KeyGenerator, AES, *, "TestConstraints.main"}, \
    {AlgorithmParameterGenerator, DiffieHellman, *, "TestConstraints.main"}, \
    {KDF, HKDF-SHA256, *, "TestConstraints.main"}, \
    {SecretKeyFactory, PBEWithMD5AndDES, *, "TestConstraints.main"}, \
    {Mac, HmacSHA256, *, "TestConstraints.main"}, \
    {AlgorithmParameters, PBES2, *, "sun.security.pkcs12.PKCS12KeyStore"}, \
    {AlgorithmParameters, PBEWithHmacSHA256AndAES_256, *, "sun.security.pkcs12.PKCS12KeyStore"}, \
    {SecretKeyFactory, PBEWithMD5AndDES, *, "sun.security.pkcs12.PKCS12KeyStore"}, \
    {Cipher, PBEWithHmacSHA256AndAES_256, *, "sun.security.pkcs12.PKCS12KeyStore"}, \
