include LibCommon.gmk

ifeq (true,$(BUILD_OPENJCEPLUS))

# Identify the desired JGSKIT target platform.
EXPORT_COMPILER_ENV_VARS :=
OPENJCEPLUS_JDK := $(JDK_OUTPUTDIR)
OPENJCEPLUS_GSKIT_HOME := $(OPENJCEPLUS_TOPDIR)/ock/jgsk_sdk
OPENJCEPLUS_HEADER_FILES := $(SUPPORT_OUTPUTDIR)/headers/openjceplus
OPENJCEPLUS_JCE_CLASSPATH := $(JDK_OUTPUTDIR)/modules/openjceplus:$(JDK_OUTPUTDIR)/modules/java.base
OPENJCEPLUS_JGSKIT_MAKE := jgskit.mak
OPENJCEPLUS_JGSKIT_MAKE_PATH := $(OPENJCEPLUS_TOPDIR)/src/main/native/ock
OPENJCEPLUS_NATIVE_PLATFORM :=
OPENJCEPLUS_OPENSSL_LIB :=
OPENJCEPLUS_OPENSSL_MAKE := openjceplus.mak
OPENJCEPLUS_OPENSSL_MAKE_PATH := $(OPENJCEPLUS_TOPDIR)/src/main/native/openssl

ifeq ($(call isTargetOs, aix), true)
  OPENJCEPLUS_NATIVE_PLATFORM := ppc-aix64
else ifeq ($(call isTargetOs, linux), true)
  # The JDK OpenSSL build uses shlib_variant=-semeru on Linux, producing libcrypto-semeru.so
  OPENJCEPLUS_OPENSSL_LIB := crypto-semeru
  ifeq ($(call isTargetCpu, aarch64), true)
    OPENJCEPLUS_NATIVE_PLATFORM := arm-linux64
  else ifeq ($(call isTargetCpu, ppc64le), true)
    OPENJCEPLUS_NATIVE_PLATFORM := ppcle-linux64
  else ifeq ($(call isTargetCpu, s390x), true)
    OPENJCEPLUS_NATIVE_PLATFORM := s390-linux64
  else ifeq ($(call isTargetCpu, x86_64), true)
    OPENJCEPLUS_NATIVE_PLATFORM := x86-linux64
  endif
else ifeq ($(call isTargetOs, macosx), true)
  ifeq ($(call isTargetCpu, aarch64), true)
    OPENJCEPLUS_NATIVE_PLATFORM := aarch64-mac
  else ifeq ($(call isTargetCpu, x86_64), true)
    OPENJCEPLUS_NATIVE_PLATFORM := x86_64-mac
  endif
  OPENJCEPLUS_JGSKIT_MAKE := jgskit.mac.mak
  OPENJCEPLUS_OPENSSL_MAKE := openjceplus.mac.mak
else ifeq ($(call isTargetOs, windows), true)
  EXPORT_COMPILER_ENV_VARS := INCLUDE='$(OPENJ9_VS_INCLUDE)' LIB='$(OPENJ9_VS_LIB)'
  ifeq ($(call isTargetCpu, x86_64), true)
    OPENJCEPLUS_JDK := $(call MixedPath,$(OPENJCEPLUS_JDK))
    OPENJCEPLUS_GSKIT_HOME := $(call MixedPath,$(OPENJCEPLUS_GSKIT_HOME))
    OPENJCEPLUS_HEADER_FILES := $(call MixedPath,$(OPENJCEPLUS_HEADER_FILES))
    OPENJCEPLUS_JCE_CLASSPATH := "$(call MixedPath,$(JDK_OUTPUTDIR)/modules/openjceplus);$(call MixedPath,$(JDK_OUTPUTDIR)/modules/java.base)"
    OPENJCEPLUS_JGSKIT_MAKE := jgskit.win64.mak
    OPENJCEPLUS_NATIVE_PLATFORM := win64
    OPENJCEPLUS_OPENSSL_DIR := $(call MixedPath,$(OPENSSL_DIR))
    OPENJCEPLUS_OPENSSL_MAKE := openjceplus.win64.mak
  endif
endif

ifeq (,$(OPENJCEPLUS_NATIVE_PLATFORM))
  $(error Unsupported platform $(OPENJDK_TARGET_OS)-$(OPENJDK_TARGET_CPU))
endif # OPENJCEPLUS_NATIVE_PLATFORM

.PHONY : compile-gskit-libs compile-openssl-libs

compile-gskit-libs :
	@$(ECHO) Compiling OpenJCEPlus GSKit native code
	$(EXPORT_COMPILER_ENV_VARS) \
		$(MAKE) \
			-C $(OPENJCEPLUS_JGSKIT_MAKE_PATH) \
			-f $(OPENJCEPLUS_JGSKIT_MAKE) \
			EXTERNAL_HEADERS=true \
			GSKIT_HOME=$(OPENJCEPLUS_GSKIT_HOME) \
			JAVA_HOME=$(OPENJCEPLUS_JDK) \
			JCE_CLASSPATH=$(OPENJCEPLUS_JCE_CLASSPATH) \
			OPENJCEPLUS_HEADER_FILES=$(OPENJCEPLUS_HEADER_FILES) \
			PLATFORM=$(OPENJCEPLUS_NATIVE_PLATFORM) \
			all
	@$(ECHO) OpenJCEplus GSKit compile complete

compile-openssl-libs :
	@$(ECHO) Compiling OpenJCEPlus OpenSSL native code
	$(EXPORT_COMPILER_ENV_VARS) \
		$(MAKE) \
			-C $(OPENJCEPLUS_OPENSSL_MAKE_PATH) \
			-f $(OPENJCEPLUS_OPENSSL_MAKE) \
			EXTERNAL_HEADERS=true \
			JAVA_HOME=$(OPENJCEPLUS_JDK) \
			OPENJCEPLUS_HEADER_FILES=$(OPENJCEPLUS_HEADER_FILES) \
			OPENSSL_HOME=$(or $(OPENJCEPLUS_OPENSSL_DIR),$(OPENSSL_DIR)) \
			OPENSSL_LIB_LOCATION=$(or $(OPENJCEPLUS_OPENSSL_DIR),$(OPENSSL_DIR)) \
			$(if $(OPENJCEPLUS_OPENSSL_LIB),OPENSSL_LIB=$(OPENJCEPLUS_OPENSSL_LIB)) \
			PLATFORM=$(OPENJCEPLUS_NATIVE_PLATFORM) \
			all
	@$(ECHO) OpenJCEplus OpenSSL compile complete

TARGETS += compile-gskit-libs compile-openssl-libs

endif # BUILD_OPENJCEPLUS
